# ═══════════════════════════════════════════════════════════════════════════════
# Production Environment Variables
# Copy this to the project root as .env and fill in the actual values
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Supabase (self-hosted) ───────────────────────────────────────────────────
# WAJIB same-origin lewat Caddy (bukan :8000/:8443 Kong langsung).
# Ganti <HOST-CADDY> dengan IP server produksi, mis. 172.19.3.171.
NEXT_PUBLIC_SUPABASE_URL=http://<HOST-CADDY>/supabase
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Legacy env var names (mapped in next.config.mjs)
SUPABASE_PUBLIC_URL=http://<HOST-CADDY>/supabase
API_EXTERNAL_URL=http://<HOST-CADDY>/supabase
ANON_KEY=<your-anon-key>
SERVICE_ROLE_KEY=<your-service-role-key>

# ─── Database ────────────────────────────────────────────────────────────────
POSTGRES_PASSWORD=<your-postgres-password>
JWT_SECRET=<your-jwt-secret>

# ─── BSrE Digital Signature ──────────────────────────────────────────────────
BSRE_USERNAME=<bsre-username>
BSRE_PASSWORD=<bsre-password>
BSRE_BASE_URL=http://172.19.0.243
BSRE_MOCK=false

# ─── NIK Encryption Keys ─────────────────────────────────────────────────────
NEXT_PUBLIC_NIK_RSA_PUBLIC_KEY="<rsa-public-key>"
NIK_RSA_PRIVATE_KEY="<rsa-private-key>"
NIK_AES_KEY="<aes-key-hex>"
NIK_HMAC_SALT="<hmac-salt-hex>"

# ─── Email (Brevo) ───────────────────────────────────────────────────────────
BREVO_API_KEY=<your-brevo-api-key>
EMAIL_USER=<sender-email>
EMAIL_PASS=<email-password>

# ─── WhatsApp Service ─────────────────────────────────────────────────────────
WA_SERVICE_URL=http://localhost:3002
NEXT_PUBLIC_WA_SERVICE_URL=http://localhost:3002

# ─── Application ─────────────────────────────────────────────────────────────
# Next.js listen di 3001 (port 3000 dipakai Supabase Studio).
SITE_URL=http://<HOST-CADDY>
NODE_ENV=production
