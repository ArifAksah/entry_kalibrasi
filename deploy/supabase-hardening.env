# ═══════════════════════════════════════════════════════════════════════════════
# Supabase self-hosted hardening overlay (temuan H4 / H5 / H6 / M7 / M8)
#
# Cara pakai:
#   1. Salin nilai-nilai di bawah ke .env stack Supabase self-hosted
#      (folder supabase/docker atau supabasedocker).
#   2. Sesuaikan <DOMAIN> dengan domain publik aplikasi.
#   3. Recreate HANYA service yang terdampak:
#        docker compose up -d --no-deps --force-recreate auth kong
#   4. Jangan jalankan `docker compose down`.
# ═══════════════════════════════════════════════════════════════════════════════

# ─── GoTrue (Auth): tutup registrasi publik + autoconfirm ─────────────────────
# Admin tetap membuat akun lewat service role (/api/personel/register).
GOTRUE_DISABLE_SIGNUP=true
GOTRUE_MAILER_AUTOCONFIRM=false
GOTRUE_SIGNUP_AUTOCONFIRM=false

# ─── GoTrue: batasi pendaftaran hanya domain instansi (opsional, jika signup dibuka) ─
# GOTRUE_DISABLE_SIGNUP=false
# GOTRUE_ALLOWED_EMAIL_DOMAINS=bmkg.go.id

# ─── GoTrue: recovery jangan membocorkan keberadaan akun ──────────────────────
# Endpoint /auth/v1/recover harus selalu membalas generic 200.
GOTRUE_SECURITY_CAPTCHA_ENABLED=true
GOTRUE_SECURITY_CAPTCHA_PROVIDER=hcaptcha
GOTRUE_SECURITY_CAPTCHA_SECRET=<recaptcha-or-hcaptcha-secret>
GOTRUE_RATE_LIMIT_HEADER=X-Forwarded-For
GOTRUE_RATE_LIMIT_EMAIL_SENT=30
GOTRUE_RATE_LIMIT_TOKEN_REFRESH=150
GOTRUE_RATE_LIMIT_VERIFY=30

# ─── URL publik: browser harus lewat reverse proxy, bukan port Kong ───────────
API_EXTERNAL_URL=https://<DOMAIN>/supabase
SUPABASE_PUBLIC_URL=https://<DOMAIN>/supabase
SITE_URL=https://<DOMAIN>
ADDITIONAL_REDIRECT_URLS=https://<DOMAIN>/*

# ─── Mailer: nonaktifkan SMTP bawaan; aplikasi memakai Brevo ──────────────────
# GOTRUE_MAILER_AUTOCONFIRM=false sudah di atas.
# Pastikan GOTRUE_SMTP_* mengarah ke relay internal sendiri, bukan default.

# ─── Kong: matikan CORS wildcard (same-origin via reverse proxy) ──────────────
KONG_CORS_ENABLE=false

# ─── Jangan pernah menaruh PII (NIK) di JWT metadata ─────────────────────────
# Pastikan GoTrue tidak mengisi app_metadata/user_metadata dengan NIK.
# NIK hanya boleh berada di tabel personel (terenkripsi) dan diterjemahkan server-side.
