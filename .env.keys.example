# NIK encryption keys — TEMPLATE ONLY
#
# Copy to `.env.keys` and fill with freshly generated values.
# Never commit the real `.env.keys` file.
#
# Generate with: npm run generate-keys  (or node scripts/generate-keys.js)
#
# Rotate immediately if any of these values were ever committed:
#   - NIK_RSA_PRIVATE_KEY
#   - NIK_AES_KEY
#   - NIK_HMAC_SALT
#   - NEXT_PUBLIC_NIK_RSA_PUBLIC_KEY (pair with the new private key)

NIK_RSA_PRIVATE_KEY=
NEXT_PUBLIC_NIK_RSA_PUBLIC_KEY=
NIK_AES_KEY=
NIK_HMAC_SALT=
