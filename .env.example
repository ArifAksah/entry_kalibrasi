# Next.js Environment Variables for Supabase VM
# NOTE: values here are PLACEHOLDERS only. Real keys live in .env.local / .env.keys
# (must never be committed). If old examples contained real JWTs, rotate the keys.

# ─── Supabase (self-hosted) ──────────────────────────────────────────────────
# PENTING (temuan H5): jangan menunjuk browser langsung ke host:port Kong
# (mis. http://IP-VM:8000). Gunakan path reverse-proxy Caddy agar port backend
# tidak pernah terekspos ke jaringan user:
NEXT_PUBLIC_SUPABASE_URL=http://172.19.3.171/supabase   # via Caddy
# NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000         # dev lokal (Kong) saja
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-anon-key>

# Server-side only. JANGAN pernah dikirim ke browser / di-commit.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>

# Legacy env var names. CATATAN (temuan V1): NEXT_PUBLIC_SUPABASE_ANON_KEY di
# atas WAJIB diisi (build akan gagal bila kosong). ANON_KEY di bawah hanya
# dipakai server-side sebagai fallback; ia TIDAK lagi diteruskan ke bundle
# browser, jadi jangan mengandalkannya untuk aplikasi klien.
SUPABASE_PUBLIC_URL=
API_EXTERNAL_URL=
ANON_KEY=

# Brevo Email Service
BREVO_API_KEY=<your-brevo-api-key-here>

# WhatsApp Service
WA_SERVICE_URL=http://localhost:3002

# WhatsApp Service (public - accessible from browser for QR code display)
NEXT_PUBLIC_WA_SERVICE_URL=http://localhost:3002
